# Server
PORT=4000
BASE_URL=http://localhost:4000
CLIENT_ORIGIN=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/linkvault

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Session cookie. Defaults (lax / not-secure) work for local dev where the
# client and server are both on "localhost" (different ports still count
# as same-site). For a real deployment where the frontend and backend are
# on different domains (e.g. Vercel + Render), cross-site cookies require:
#   COOKIE_SAMESITE=none
#   COOKIE_SECURE=true      (requires HTTPS, which both platforms provide)
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
# COOKIE_DOMAIN=

# Share defaults
DEFAULT_EXPIRY_MINUTES=10
MAX_FILE_SIZE_MB=20

# Comma-separated MIME prefixes to allow (leave empty to allow all,
# except the extensions blocked below regardless of MIME type).
ALLOWED_MIME_PREFIXES=image/,text/,application/pdf,application/zip

# Comma-separated file extensions to always reject, regardless of
# declared MIME type. Leave unset to use the built-in default list
# (exe, bat, cmd, msi, scr, vbs, js, ps1, sh, apk, dll, ...).
BLOCKED_EXTENSIONS=

# Storage
STORAGE_PROVIDER=local
STORAGE_DIR=uploads

# --- Cloudflare R2 --- set STORAGE_PROVIDER=r2 and fill these in to use it.
# Create an R2 bucket (keep it private - no public access) and an R2 API
# token (Account Home > R2 > Manage R2 API Tokens) with read+write access
# scoped to that bucket.
# If any of these were ever committed as real values, rotate them.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional - defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
